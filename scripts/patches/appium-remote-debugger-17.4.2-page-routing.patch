+    rpc.send = async (command: string, opts: any) => {
+      if (command === 'setSenderKey') {
+        setups.push(opts);
+      }
+    };
+    rpc._initializePage = async () => false;
+    const selected = () =>
+      new Promise<void>((resolve) => {
+        rpc._pageSelectionMonitor.once('newListener', (name: string) => {
+          if (name === 'onPageInitialized') {
+            resolve();
+          }
+        });
+      });
+    let ready = selected();
+    const first = client.selectPage('PID:123', 1);
+    await ready;
+    ready = selected();
