 describe('rpc-client', function () {
+  for (const failFirst of [false, true]) {
+    it(`detaches every selected page before disconnect, failure=${failFirst}`, async function () {
+      const client = new RpcClient();
+      const rpc = client as any;
+      rpc._pageTargetsBySenderId.set('first', {appIdKey: 'PID:123', pageIdKey: 1});
+      rpc._pageTargetsBySenderId.set('second', {appIdKey: 'PID:123', pageIdKey: 2});
+      const sent: any[] = [];
+      rpc.send = async (...args: any[]) => {
+        sent.push(args);
+        if (failFirst && sent.length === 1) {
+          throw new Error('Socket write failed');
+        }
+      };
+      if (failFirst) {
+        await assert.rejects(client.disconnect(), AggregateError);
+      } else {
+        await client.disconnect();
+      }
+      assert.deepEqual(sent, [
+        ['forwardDidClose', {appIdKey: 'PID:123', pageIdKey: 1, senderId: 'first'}, false],
+        ['forwardDidClose', {appIdKey: 'PID:123', pageIdKey: 2, senderId: 'second'}, false],
+      ]);
+      assert.equal(rpc.messageHandler.eventNames().length, 0);
+      await client.disconnect();
+      assert.equal(sent.length, 2);
+    });
+  }
+
+  it('routes overlapping page selections by their wire destination', async function () {
+    const client = new RpcClient({targetCreationTimeoutMs: 200, platformVersion: '26.2'});
+    const rpc = client as any;
