+    await ready;
+    const receive = async (destination: string, targetId: string, app = 'PID:123') => {
+      await rpc.messageHandler.handleMessage({
+        __selector: '_rpc_applicationSentData:',
+        __argument: {
+          WIRApplicationIdentifierKey: app,
+          WIRDestinationKey: destination,
+          WIRMessageDataKey: JSON.stringify({
+            method: 'Target.targetCreated',
+            params: {targetInfo: {type: 'page', targetId}},
+          }),
+        },
+      });
+    };
+    try {
+      assert.ok(setups[0].senderId);
+      assert.notEqual(setups[0].senderId, setups[1].senderId);
+      await receive('unknown-destination', 'ignored-target');
+      await receive(setups[0].senderId, 'wrong-app-target', 'PID:456');
+      assert.equal(client.getTarget('PID:123', 1), undefined);
+      await receive(setups[0].senderId, 'target-for-first-page');
+      await receive(setups[1].senderId, 'target-for-second-page');
+      assert.equal(client.getTarget('PID:123', 1), 'target-for-first-page');
+      assert.equal(client.getTarget('PID:123', 2), 'target-for-second-page');
+    } finally {
+      await Promise.all([first, second]);
+    }
+  });
