diff --git a/test/unit/xcodebuild-ownership.spec.ts b/test/unit/xcodebuild-ownership.spec.ts
new file mode 100644
--- /dev/null
+++ b/test/unit/xcodebuild-ownership.spec.ts
@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict';
+import {EventEmitter} from 'node:events';
+import {afterEach, describe, it, mock} from 'node:test';
+
+const processes: ProbeProcess[] = [];
+class ProbeProcess extends EventEmitter {
+  detector?: boolean | null;
+  constructor(
+    _command: string,
+    _args: string[],
+    readonly options: {detached: boolean},
+  ) {
+    super();
+    processes.push(this);
+  }
+  async start(detector: boolean | null) {
+    if (detector === true && !this.options.detached) {
+      throw new Error('Cannot detach an inherited process');
+    }
+    this.detector = detector;
+    queueMicrotask(() => this.emit('exit', 0, null));
+  }
+}
+
+const teenProcess = await import('teen_process');
+mock.module('teen_process', {namedExports: {...teenProcess, SubProcess: ProbeProcess}});
+const {XcodeBuild} = await import('../../lib/xcodebuild.js');
+
+describe('xcodebuild process ownership', () => {
+  const original = process.env.APPIUM_WDA_INHERIT_PROCESS_GROUP;
+  afterEach(() => {
+    if (original === undefined) {
+      delete process.env.APPIUM_WDA_INHERIT_PROCESS_GROUP;
+    } else {
+      process.env.APPIUM_WDA_INHERIT_PROCESS_GROUP = original;
+    }
+    processes.length = 0;
+  });
+
+  for (const inherited of [false, true]) {
+    it(inherited ? 'retains the managed parent process group' : 'preserves standalone detachment', async () => {
+      if (inherited) {
+        process.env.APPIUM_WDA_INHERIT_PROCESS_GROUP = '1';
+      } else {
+        delete process.env.APPIUM_WDA_INHERIT_PROCESS_GROUP;
+      }
+      const build = new XcodeBuild(
+        {udid: 'sashoush-simulator'},
+        {
+          realDevice: false,
+          agentPath: 'WebDriverAgent.xcodeproj',
+          bootstrapPath: '.',
+        },
+      );
+      await build.start(true);
+      assert.equal(processes.length, 1);
+      assert.equal(processes[0].options.detached, !inherited);
+      assert.equal(processes[0].detector, inherited ? null : true);
+    });
+  }
+});
