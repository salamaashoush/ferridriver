diff --git 1/test/unit/new-window.spec.ts 2/test/unit/new-window.spec.ts
new file mode 100644
index 0000000..913851c
--- /dev/null
+++ 2/test/unit/new-window.spec.ts
@@ -0,0 +1,106 @@
+import assert from 'node:assert/strict';
+import {it} from 'node:test';
+import {runInNewContext} from 'node:vm';
+
+import {RemoteDebugger} from 'appium-remote-debugger';
+
+import * as windowCommands from '../../lib/commands/window.js';
+import {AtomsBackend} from '../../lib/web-execution/atoms-backend.js';
+
+it('creates and identifies its own tab without changing the selected window', async () => {
+  let selected = 'original';
+  let marker = '';
+  const calls: any[] = [];
+  const driver: any = {
+    isWebContext: () => true,
+    getWindowHandle: async () => 'original',
+    getWindowHandles: async () => (marker ? ['unrelated', 'original', 'created'] : ['original']),
+    setWindow: async (handle: string) => {
+      selected = handle;
+    },
+    remote: {
+      execute: async (script: string, _override?: boolean, options?: any) => {
+        calls.push({script, selected, options});
+        if (options?.emulateUserGesture) {
+          marker = script.match(/__fd_window_[a-f0-9-]+/)![0];
+          return true;
+        }
+        if (script === '({value: window.name})') {
+          return selected === 'created' ? marker : 'another-popup';
+        }
+        return true;
+      },
+    },
+  };
+  driver._webExecutionBackend = new AtomsBackend(driver);
+  const result = await windowCommands.createNewWindow.call(driver, 'tab');
+  assert.deepEqual(result, {handle: 'created', type: 'tab'});
+  assert.equal(selected, 'original');
+  assert.equal(calls.filter((call) => call.options?.emulateUserGesture).length, 1);
+  assert.ok(calls.some((call) => call.selected === 'created' && call.script.includes('window.name =')));
+  assert.ok(calls.at(-1).script.includes('delete window['));
+});
+
+it('closes its opened tab and restores selection when identification fails', async () => {
+  let selected = 'original';
+  let created = false;
+  let cleanup = '';
+  const driver: any = {
+    isWebContext: () => true,
+    getWindowHandle: async () => 'original',
+    getWindowHandles: async () => (created ? ['created', 'original'] : ['original']),
+    setWindow: async (handle: string) => {
+      selected = handle;
+    },
+    remote: {
+      execute: async (script: string, _override?: boolean, options?: any) => {
+        if (options?.emulateUserGesture) {
+          created = true;
+          return true;
+        }
+        if (script === '({value: window.name})') {
+          throw new Error('inspection failed');
+        }
+        cleanup = script;
+        return true;
+      },
+    },
+  };
+  driver._webExecutionBackend = new AtomsBackend(driver);
+  await assert.rejects(windowCommands.createNewWindow.call(driver, 'tab'), /inspection failed/);
+  assert.equal(selected, 'original');
+  assert.ok(cleanup.includes('delete window['));
+  assert.ok(cleanup.includes('if (true && child && !child.closed) child.close()'));
+});
+
+it('uses value envelopes accepted by the real remote debugger converter', async () => {
+  let selected = 'original';
+  const windows: Record<string, any> = {original: {name: '', closed: false}};
+  windows.original.open = (_url: string, name: string) => {
+    windows.created = {name, opener: windows.original, closed: false};
+    return windows.created;
+  };
+  const remote: any = new RemoteDebugger({});
+  remote._appIdKey = 'app';
+  remote._pageIdKey = 'page';
+  remote.requireRpcClient = () => ({
+    waitForPage: async () => {},
+    send: async (_method: string, opts: any) =>
+      JSON.parse(JSON.stringify(runInNewContext(opts.expression, {window: windows[selected]}))),
+  });
+  const driver: any = {
+    isWebContext: () => true,
+    getWindowHandle: async () => selected,
+    getWindowHandles: async () => Object.keys(windows),
+    setWindow: async (handle: string) => {
+      selected = handle;
+    },
+    remote,
+  };
+  driver._webExecutionBackend = new AtomsBackend(driver);
+  assert.deepEqual(await windowCommands.createNewWindow.call(driver), {handle: 'created', type: 'tab'});
+  assert.equal(selected, 'original');
+  assert.equal(windows.created.opener, null);
+  assert.equal(windows.created.name, '');
+  assert.deepEqual(Object.keys(windows.original).sort(), ['closed', 'name', 'open']);
+});
